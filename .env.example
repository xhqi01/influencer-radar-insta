# ============================================================
# サーバー側に API トークンは一切不要です。
# Apify / Anthropic のトークンは各利用者が画面右上の「API設定」から
# 自分で入力します（各自のブラウザにのみ保存されます）。
# ============================================================

# DB の保存先（任意。既定はアプリと同じフォルダの radar.db）
RADAR_DB=

# 共有時は 0.0.0.0、ローカル確認だけなら未設定でよい
HOST=
PORT=8000

# 開発時のみ 1
FLASK_DEBUG=
